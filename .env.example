# URL da API GraphQL
NEXT_PUBLIC_API_URL=http://localhost:3000/graphql

# Google OAuth Client ID for vendor login
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Pagar.me public key for card tokenization
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=

# Pagar.me API base URL (default: https://api.pagar.me/core/v5)
NEXT_PUBLIC_PAGARME_API_URL=

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Third-party APIs (all have defaults, only set to override)
NEXT_PUBLIC_VIACEP_URL=
NEXT_PUBLIC_NOMINATIM_URL=
NEXT_PUBLIC_OPENFOODFACTS_URL=
